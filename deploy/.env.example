# The server's environment (~/stacks/chaperone/.env), and what CI runs the deploy checks with.
# Each variable says what it does, where to get a value, and what happens while it's unset.
# Optional features are off until their variables are set; leave those commented out.
# Never put a real value in this file: it is committed. The real values go in the server's .env.

# The image to run: ghcr.io/<owner>/<repo> in lower case. The deploy workflow pushes it, and sets
# the same value for its own run. Change it when the repository is renamed. Required: compose
# refuses to start without it.
IMAGE_REPO=ghcr.io/omarg-dev/paypal-ai

# Which tag of that image to run. The deploy pushes :prod and :prod-<commit>; set the second to go
# back to an earlier release. Unset: prod.
IMAGE_TAG=prod

# The container's name, which the Caddy gateway's site block proxies to. Unset: chaperone.
CONTAINER_NAME=chaperone

# Port the server listens on inside the container. Nothing is published on the host, so this only
# has to match the port in the Caddy site block. Unset: 3000.
PORT=3000

# Folder for the server's state (the event log, events.db), inside the container. The image sets it
# to /data and compose mounts ./data there, so leave it. Unset: /data.
DATA_DIR=/data

# Folder of the eval's results files, which the dashboard shows (GET /eval/results). It is inside
# the mounted data folder, so copy a results file to ~/stacks/chaperone/data/results/ and the
# dashboard has it, with no redeploy. Unset: the dashboard says there are no results yet.
RESULTS_DIR=/data/results

# Live runs (the Start a run page) are off until this is set. The app's own Anthropic API key, from
# the Claude Console (API keys). Make it a key with a low spend limit of its own. The code never
# reads ANTHROPIC_API_KEY. Unset: the page says live runs are off; replays, the dashboard and the
# rest keep working.
# FIREWALL_ANTHROPIC_API_KEY=

# Where model calls go. Unset: https://api.anthropic.com.
# FIREWALL_ANTHROPIC_BASE_URL=

# The most live runs may spend in a UTC day, in US dollars, counted from the event log so a restart
# can't reset it. At the cap a draft or a start is refused with a 429. 0 turns live runs off even
# with a key. Unset: 0.25.
FIREWALL_LIVE_DAILY_USD=0.25

# Channel3's product search API key, for Gate 2's real-market price reference. From a Channel3
# developer account. Unset: Gate 2 checks prices only against the arena's own listings.
# FIREWALL_CHANNEL3_API_KEY=

# The payment platform's sandbox, for live runs and for deciding held purchases with real sandbox
# money. Sandbox credentials only, never live ones. Client ID and secret: the sandbox app on the
# developer dashboard. The client ID and secret, the six merchant IDs and the vault ID below turn the
# sandbox on (the vault ID only for live runs); unset or incomplete, the server holds money in an in-memory fake ("Practice money" on the page) and
# says so at start-up. Nothing from the fake is a sandbox result.
# SANDBOX_CLIENT_ID=
# SANDBOX_CLIENT_SECRET=
# The arena's merchant accounts, by the merchant ID on each sandbox account's details page.
# SANDBOX_MERCHANT_SELLER_1=
# SANDBOX_MERCHANT_SELLER_2=
# SANDBOX_MERCHANT_SELLER_3=
# SANDBOX_MERCHANT_SELLER_4=
# SANDBOX_MERCHANT_ATTACKER_1=
# SANDBOX_MERCHANT_ATTACKER_2=
# The buyer's sandbox login. Used by the scripted approvals, which run on a developer machine, not on
# the server; the server doesn't need them.
# SANDBOX_BUYER_EMAIL=
# SANDBOX_BUYER_PASSWORD=
# The buyer's saved wallet, from `pnpm --filter @firewall/payments save-wallet` on a developer
# machine. The server can't save one itself. Unset: with the sandbox connected, live runs are off and
# the page says what's missing; replays and decisions on imported runs' practice holds still work.
# SANDBOX_BUYER_VAULT_ID=
