{
  "name": "@firewall/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "check": "tsc --noEmit -p .",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "export-runs": "tsx --env-file-if-exists=../../.env src/cli-main.ts export-runs",
    "import-runs": "tsx --env-file-if-exists=../../.env src/cli-main.ts import-runs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@firewall/agent": "workspace:*",
    "@firewall/arena": "workspace:*",
    "@firewall/eval": "workspace:*",
    "@firewall/events": "workspace:*",
    "@firewall/firewall": "workspace:*",
    "@firewall/mandate": "workspace:*",
    "@firewall/payments": "workspace:*",
    "@hono/node-server": "2.1.5",
    "@hono/zod-validator": "0.9.1",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@firewall/web": "workspace:*",
    "@types/better-sqlite3": "9.6.0",
    "ai": "7.0.134",
    "esbuild": "0.28.2",
    "tsx": "4.23.15"
  }
}
